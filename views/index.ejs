<!DOCTYPE html>
<html>
<head>
    <title>Student SPA</title>

    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
            text-align: center;
        }

        h1 {
            color: #333;
        }

        button {
            padding: 10px 20px;
            background-color: blue;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }

        .student {
            background-color: white;
            width: 400px;
            margin: 15px auto;
            padding: 15px;
            border-radius: 8px;
            box-shadow: 0 0 5px gray;
        }
    </style>
</head>

<body>

    <h1>Student Management SPA</h1>

    <button onclick="loadStudents()">Load Students</button>

    <div id="students"></div>

    <script>
        async function loadStudents() {

            const response =
                await fetch("https://jsonplaceholder.typicode.com/users");

            const students = await response.json();

            let output = "";

            students.forEach(student => {

                output += `
                    <div class="student">
                        <h2>${student.name}</h2>
                        <p>Email: ${student.email}</p>
                        <p>City: ${student.address.city}</p>
                    </div>
                `;

            });

            document.getElementById("students").innerHTML = output;
        }
    </script>

</body>
</html>
